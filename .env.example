JWT_SECRET=CHANGE_ME_BASE64
ADMIN_PASSWORD_HASH=CHANGE_ME_BCRYPT_HASH
TEMP_PASSWORD_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES
WEBAUTHN_RP_ID=thelongislanderhome.asuscomm.com
WEBAUTHN_RP_NAME=The Long Islander Home
WEBAUTHN_ORIGIN=https://thelongislanderhome.asuscomm.com
APP_ORIGINS=https://thelongislanderhome.asuscomm.com
START_COMMAND_PATH=/path/to/start_auto.command
MINECRAFT_SERVER_PATH=/path/to/server/
MINECRAFT_SCREEN_SESSION=MinecraftSession
MINECRAFT_LOG_PATH=/path/to/server/logs/latest.log
MINECRAFT_TIME_ZONE=America/New_York
CHAT_DB_PATH=./chat.db
CHAT_SCREEN_MAX_COMMAND_BYTES=512
CHAT_RETENTION_DAYS=0
# Leave unset unless HTTP is behind a known reverse proxy. Examples: loopback or 1.
TRUST_PROXY=
BACKUP_PATH=/path/to/backups
PORT=8087
SFTP_HOST=127.0.0.1
SFTP_PORT=2222
SFTP_USERNAME=your_sftp_user
SFTP_PASSWORD=your_sftp_password
TMP_UPLOAD_SERVER_PATH=/path/to/tmp
